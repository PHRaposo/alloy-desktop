(defmethod layout ((view view)) (image-layout (view-image view)))
(defmethod channel-type ((view view)) (image-channel-type (view-image view)))
(defmethod origin ((view view)) (image-origin (view-image view)))
(defmethod w ((view view)) (view-w view))
