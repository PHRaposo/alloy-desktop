(defun superfluous-view-p (view)
  (and (= (x view) 0)
       (= (y view) 0)
       (= (z view) 0)
       (let ((image (image view)))
         (and (= (w view) (w image))
              (= (h view) (h image))
              (= (d view) (d image))))))

(defun valid-view-p (view)
  (let ((image (image view)))
    (and (<= (w view) (w image))
         (<= (h view) (h image))
         (<= (d view) (d image))
         (<= (x view) (- (w image) (w view)))
         (<= (y view) (- (h image) (h view)))
         (<= (z view) (- (d image) (d view))))))

(defun check-view (view)
  (unless (valid-view-p view)
    (error 'invalid-view :view view)))

(defmethod ensure-image ((view view))
  (if (superfluous-view-p view)
      (image view)
      (make-image* (make-array (* (w view) (h view) (d view)
                                  (pixel-stride view))
                               :element-type '(unsigned-byte 8))
                   (channel-type view)
                   (layout view)
                   (w view) (h view) (d view)
                   (origin view))))

(defmethod ensure-image ((path pathname))
  (load-image path T))

(defmethod ensure-image ((stream stream))
  (load-image stream T))

(defmethod load-image (source (type string) &rest args &key &allow-other-keys)
  (apply #'load-image source (ensure-file-type type) args))

(defmethod load-image (source (type (eql T)) &rest args &key &allow-other-keys)
  (apply #'load-image source (kw (ensure-file-type source)) args))

(defmethod load-image ((path string) (type symbol) &rest args &key &allow-other-keys)
  (if (eql T type) (call-next-method)
      (apply #'load-image (pathname path) type args)))

(defmethod load-image ((path pathname) (type symbol) &rest args &key &allow-other-keys)
  (if (eql T type) (call-next-method)
      (with-open-file (stream path :direction :input
                                   :element-type '(unsigned-byte 8)
                                   :if-exists :supersede)
        (apply #'load-image stream type args))))

(defmethod load-image (source (type symbol) &key &allow-other-keys)
  (let ((types (delete T (list-eql-specializers #'load-image 1))))
    (error 'unsupported-format :format-type type :source source :supported-formats types)))

(defmethod save-image (source target (type string) &rest args &key &allow-other-keys)
  (apply #'save-image source target (ensure-file-type type) args))

(defmethod save-image (source target (type (eql T)) &rest args &key &allow-other-keys)
  (apply #'save-image source target (kw (ensure-file-type target)) args))

(defmethod save-image (source (path string) (type symbol) &rest args &key &allow-other-keys)
  (if (eql T type) (call-next-method)
      (apply #'save-image source (pathname path) type args)))

(defmethod save-image (source (path pathname) (type symbol) &rest args &key &allow-other-keys)
  (if (eql T type) (call-next-method)
      (with-open-file (stream path :direction :output
                                   :element-type '(unsigned-byte 8)
                                   :if-exists :supersede)
        (apply #'save-image source stream type args))))

(defmethod save-image (source target (type symbol) &key &allow-other-keys)
  (let ((types (delete T (list-eql-specializers #'save-image 2))))
    (error 'unsupported-format :format-type type :source source :supported-formats types)))

(defmethod save-image ((source view) target type &rest args &key &allow-other-keys)
  (apply #'save-image (ensure-image source) target type args))

(defmethod transfer ((source image) target)
  (let ((source (make-view source)))
    (declare (dynamic-extent source))
    (transfer source target)))

(defmethod transfer (source (target image))
  (let ((target (make-view target)))
    (declare (dynamic-extent target))
    (transfer source target)))


