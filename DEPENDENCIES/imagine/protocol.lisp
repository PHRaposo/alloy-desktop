(in-package #:org.shirakumo.fraf.imagine)

(deftype layout ()
  '(or (member :r :ra :rgb :rgba :ar :bgr :bgra :abgr :argb)
    keyword))

(deftype origin ()
  '(member :top-left :top-right :bottom-left :bottom-right))

(deftype channel-type ()
  '(or (member
        :unsigned-byte :unsigned-short :unsigned-int :unsigned-long
        :signed-byte :signed-short :signed-int :signed-long
        :half-float :float :double)
    keyword))

(deftype dimension ()
  '(unsigned-byte 32))

(deftype stride ()
  '(unsigned-byte 32))

(defgeneric load-image (source type &key decode))
(defgeneric save-image (source target type &key))
(defgeneric transfer (source target))
(defgeneric adjust (source &key channel-type layout origin))
(defgeneric pixel-stride (image))
(defgeneric row-stride (image))
(defgeneric layer-stride (image))
(defgeneric data (image))
(defgeneric channel-type (image))
(defgeneric layout (image))
(defgeneric origin (image))
(defgeneric channel-reader (data channel-type))
(defgeneric channel-writer (data channel-type))
(defgeneric pixel-reader (layout))
(defgeneric pixel-writer (layout))
(defgeneric w (image))
(defgeneric h (image))
(defgeneric d (image))
(defgeneric x (image))
(defgeneric y (image))
(defgeneric z (image))

(declaim (ftype (function (T) (values stride &optional))
                pixel-stride row-stride layer-stride))
(declaim (ftype (function (T) (values dimension &optional))
                w h d x y z))

(defmacro with-pixel-data ((accessor pixel-data channel-type) &body body)
  (let ((data (gensym "DATA"))
        (reader (gensym "READER"))
        (writer (gensym "WRITER")))
    `(let* ((,data ,pixel-data)
            (,reader (channel-reader ,data ,channel-type))
            (,writer (channel-writer ,data ,channel-type)))
       (declare (type (function (T (unsigned-byte 32)) (values real &optional)) ,reader))
       (declare (type (function (real T (unsigned-byte 32)) (values real &optional)) ,writer))
       (declare (ignorable ,data ,reader ,writer))
       (flet ((,accessor (i)
                (declare (optimize speed (safety 0)))
                (declare (type (unsigned-byte 32) i))
                (funcall ,reader ,data i))
              ((setf ,accessor) (value i)
                (declare (optimize speed (safety 0)))
                (declare (type (unsigned-byte 32) i))
                (declare (type real value))
                (funcall ,writer value ,data i)))
         (declare (dynamic-extent #',accessor #'(setf ,accessor)))
         (declare (inline ,accessor (setf ,accessor)))
         (declare (ignorable #',accessor #'(setf ,accessor)))
         ,@body))))

(defmacro with-image-pixels ((accessor image) &body body)
  (let ((img (gensym "IMG")))
    `(let ((,img ,image))
       (with-pixel-data (,accessor (data ,img) (channel-type ,img))
         ,@body))))

(defmacro with-image-pixels* (bindings &body body)
  (if bindings
      `(with-image-pixels ,(pop bindings)
         (with-image-pixels* ,bindings
           ,@body))
      `(progn ,@body)))

(defmacro with-view ((accessor view) &body body)
  (let ((vw (gensym "VIEW"))
        (img (gensym "IMG"))
        (x-stride (gensym "X-STRIDE"))
        (y-stride (gensym "Y-STRIDE"))
        (z-stride (gensym "Z-STRIDE"))
        (origin (gensym "ORIGIN"))
        (w (gensym "W"))
        (h (gensym "H"))
        (d (gensym "D"))
        (pixel (gensym "PIXEL")))
    `(let* ((,vw ,view)
            (,img (image ,vw))
            (,x-stride (pixel-stride ,vw))
            (,y-stride (* x-stride (w ,img)))
            (,z-stride (* y-stride (h ,img)))
            (,origin (+ (* ,x-stride (x ,vw))
                        (* ,y-stride (y ,vw))
                        (* ,z-stride (z ,vw))))
            (,w (* ,x-stride (w ,vw)))
            (,h (* ,w (h ,vw)))
            (,d (* ,h (d ,vw))))
       (with-pixels (,pixel) ,img
         (flet ((,accessor (i)
                  (multiple-value-bind (z r) (floor i d)
                    (multiple-value-bind (y i) (floor i h)
                      (multiple-value-bind (z c) (floor z w)
                        (,pixel (+ c ,origin
                                   (* x ,x-stride)
                                   (* y ,y-stride)
                                   (* z ,z-stride)))))))
                ((setf ,accessor) (value i)
                  (multiple-value-bind (z r) (floor i d)
                    (multiple-value-bind (y i) (floor i h)
                      (multiple-value-bind (z c) (floor z w)
                        (setf (,pixel (+ c ,origin
                                         (* x ,x-stride)
                                         (* y ,y-stride)
                                         (* z ,z-stride)))
                              value))))))
           (declare (dynamic-extent #',accessor #'(setf ,accessor)))
           (declare (inline ,accessor (setf ,accessor)))
           (declare (ignorable #'accessor #'(setf ,accessor)))
           ,@body)))))

(defun image-compatible-p (image layouts &key (origin :top-left) (channel-types '(:unsigned-byte)))
  (and (member (channel-type image) channel-types)
       (member (layout image) layouts)
       (eql (origin image) origin)))

(defun closest-pixel-stride (thing choices)
  (if (member thing choices)
      thing
      (loop with ref = (pixel-stride thing)
            with best = NIL
            with best-distance = most-negative-fixnum
            for choice in choices
            for distance = (- (pixel-stride choice) ref)
            do (when (or (< (abs distance) (abs best-distance))
                         (and (< best-distance 0) (< best-distance distance)))
                 ;; We use the extra checks in order to prefer upgrading
                 ;; to a larger container over downgrading to a smaller one
                 ;; that would lose us information
                 (setf best choice)
                 (setf best-distance distance))
            finally (return best))))

(defun check-image-compatible (image layouts &key (origin :top-left) (channel-types '(:unsigned-byte)))
  (unless (image-compatible-p image layouts :channel-types channel-types :origin origin)
    (restart-case (error 'pixel-data-incompatible :source image :target (list channel-types layouts origin))
      (adjust ()
        :report "Adjust the pixel data to be compatible."
        (adjust image :origin origin
                      :layout (closest-pixel-stride (layout image) layouts)
                      :channel-type (closest-pixel-stride (channel-type image) channel-types))))))

(defmethod pixel-stride ((_ (eql :r))) 1)
(defmethod pixel-stride ((_ (eql :ra))) 2)
(defmethod pixel-stride ((_ (eql :ar))) 2)
(defmethod pixel-stride ((_ (eql :rgb))) 3)
(defmethod pixel-stride ((_ (eql :bgr))) 3)
(defmethod pixel-stride ((_ (eql :rgba))) 4)
(defmethod pixel-stride ((_ (eql :bgra))) 4)
(defmethod pixel-stride ((_ (eql :argb))) 4)
(defmethod pixel-stride ((_ (eql :abgr))) 4)
(defmethod pixel-stride ((_ (eql :unsigned-byte))) 1)
(defmethod pixel-stride ((_ (eql :unsigned-short))) 2)
(defmethod pixel-stride ((_ (eql :unsigned-int))) 4)
(defmethod pixel-stride ((_ (eql :unsigned-long))) 8)
(defmethod pixel-stride ((_ (eql :signed-byte))) 1)
(defmethod pixel-stride ((_ (eql :signed-short))) 2)
(defmethod pixel-stride ((_ (eql :signed-int))) 4)
(defmethod pixel-stride ((_ (eql :signed-long))) 8)
(defmethod pixel-stride ((_ (eql :short-float))) 2)
(defmethod pixel-stride ((_ (eql :float))) 4)
(defmethod pixel-stride ((_ (eql :double))) 8)

(declaim (inline make-image))
(defstruct (image
            (:constructor make-image (&key data
                                           (channel-type :unsigned-byte) (layout :rgba)
                                           (w 0) (h 0) (d 0) (origin :top-left)))
            (:predicate NIL))
  (data NIL)
  (channel-type :unsigned-byte :type keyword)
  (layout :rgba :type layout)
  (origin :top-left :type origin)
  (w 0 :type (unsigned-byte 32))
  (h 0 :type (unsigned-byte 32))
  (d 0 :type (unsigned-byte 32)))

(defmethod print-object ((image image) stream)
  (print-unreadable-object (image stream :type T :identity T)
    (format stream "~dx~d~@[x~d~] ~a ~a ~a"
            (image-w image) (image-h image) (when (<= 1 (image-d image)) (image-d image))
            (image-channel-type image) (image-layout image) (image-origin image))))

(defmethod pixel-stride ((image image))
  (* (pixel-stride (image-channel-type image))
     (pixel-stride (image-layout image))))
(defmethod row-stride ((image image))
  (* (pixel-stride image) (image-w image)))
(defmethod layer-stride ((image image))
  (* (pixel-stride image) (image-w image) (image-h image)))
(defmethod data ((image image)) (image-data image))
(defmethod (setf data) (data (image image)) (setf (image-data image) data))
(defmethod layout ((image image)) (image-layout image))
(defmethod channel-type ((image image)) (image-channel-type image))
(defmethod origin ((image image)) (image-origin image))
(defmethod w ((image image)) (image-w image))
(defmethod h ((image image)) (image-h image))
(defmethod d ((image image)) (image-d image))
(defmethod x ((image image)) 0)
(defmethod y ((image image)) 0)
(defmethod z ((image image)) 0)
(defmethod image ((image image)) image)
(defmethod ensure-image ((image image)) image)

(defun make-image* (data channel-type layout width height &optional (depth 1) (origin :top-left))
  (make-image :data data :channel-type channel-type :layout layout :w width :h height :d depth :origin origin))

(declaim (inline make-view))
(defstruct (view
            (:constructor make-view (image &key (x 0) (y 0) (z 0) (w (w image)) (h (h image)) (d (d image))))
            (:predicate NIL))
  (image NIL :type image)
  (x 0 :type (unsigned-byte 32))
  (y 0 :type (unsigned-byte 32))
  (z 0 :type (unsigned-byte 32))
  (w 0 :type (unsigned-byte 32))
  (h 0 :type (unsigned-byte 32))
  (d 0 :type (unsigned-byte 32)))

(defmethod print-object ((view view) stream)
  (print-unreadable-object (view stream :type t)
    (if (<= 1 (view-d view))
        (format stream "~d,~d,~d ~dx~dx~d"
                (view-x view) (view-y view) (view-z view)
                (view-w view) (view-h view) (view-d view))
        (format stream "~d,~d ~dx~d"
                (view-x view) (view-y view)
                (view-w view) (view-h view)))))

