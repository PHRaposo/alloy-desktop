(in-package #:org.shirakumo.fraf.imagine)

(defmethod transfer ((source view) (target view))
  (check-view source)
  (check-view target)
  (unless (and (eql (channel-type source) (channel-type target))
               (eql (layout source) (layout target))
               (eql (origin source) (origin target)))
    (restart-case (error 'pixel-data-incompatible :source (image source) :target (image target))
      (adjust-source ()
        :report "Adjust the source image to match the target image spec."
        (adjust source :channel-type (channel-type target) :layout (layout target) :origin (origin target)))
      (adjust-target ()
        :report "Adjust the target image to match the source image spec."
        (adjust target :channel-type (channel-type source) :layout (layout source) :origin (origin source)))))
  (let ((sp (pixel-stride source))
        (tp (pixel-stride target))
        (sr (row-stride source))
        (tr (row-stride target))
        (sl (layer-stride source))
        (tl (layer-stride target))
        (h (min (h source) (h target)))
        (w (min (w source) (w target))))
    (let ((si (+ (* (x source) (pixel-stride source))
                 (* (y source) sr)
                 (* (z source) sl)))
          (ti (+ (* (x target) (pixel-stride target))
                 (* (y target) tr)
                 (* (z target) tl))))
      (with-image-pixels* ((src source)
                           (dst target))
        (dotimes (z (min (d source) (d target)))
          (let ((si si) (ti ti))
            (dotimes (y h)
              (let ((si si) (ti ti))
                (dotimes (x w)
                  (setf (dst ti) (src si))
                  (incf si sp)
                  (incf ti tp)))
              (incf si sr)
              (incf ti tr)))
          (incf si sl)
          (incf ti tl))))))

(defmethod adjust ((image image) &key channel-type layout origin w h d)
  (when (or (and w (not (= w (w image))))
            (and h (not (= h (h image))))
            (and d (not (= d (d image)))))
    (resize image :w w :h h :d d))
  (when (and origin (not (eql origin (origin image))))
    (adjust-origin image origin))
  (when (and layout (not (eql layout (layout image))))
    (adjust-layout image layout))
  (when (and channel-type (not (eql channel-type (channel-type image))))
    (adjust-channel-type image channel-type))
  image)

(defun adjust-channel-type (image channel-type)
  (let ((new (make-array (* (pixel-stride channel-type)
                            (pixel-stride (layout image))
                            (max 1 (w image)) (max 1 (h image)) (max 1 (d image)))
                         :element-type '(unsigned-byte 8)))
        (old (data image))
        (read-stride (pixel-stride (channel-type image)))
        (write-stride (pixel-stride channel-type)))
    (with-pixel-data (src old (channel-type image))
      (with-pixel-data (dst new channel-type)
        (dotimes (i (* (pixel-stride (layout image))
                       (w image) (h image) (d image)))
          (setf (dst (* i write-stride)) (src (* i read-stride))))))
    (setf (image-channel-type image) channel-type)
    (setf (data image) new)))

(defun adjust-layout (image layout)
  (let* ((type (channel-type image))
         (channel-stride (pixel-stride type))
         (read-stride (* channel-stride (pixel-stride (layout image))))
         (write-stride (* channel-stride (pixel-stride layout)))
         (new (make-array (* write-stride (w image) (h image) (d image))
                          :element-type '(unsigned-byte 8)))
         (reader (pixel-reader (layout image)))
         (writer (pixel-writer layout))
         (old (data image)))
    (with-pixel-data (src old type)
      (with-pixel-data (dst new type)
        (dotimes (i (* (w image) (h image) (d image)))
          (multiple-value-bind (r g b a) (funcall reader #'src (* i read-stride) channel-stride)
            (funcall writer #'(setf dst) (* i write-stride) channel-stride r g b a)))))
    (setf (image-layout image) layout)
    (setf (data image) new)))

(defun adjust-origin (image origin)
  (flet ((v-gravity (origin)
           (ecase origin
             ((:top-left :top-right) :top)
             ((:bottom-left :bottom-right) :bottom)))
         (h-gravity (origin)
           (ecase origin
             ((:top-left :bottom-left) :left)
             ((:top-right :bottom-right) :right))))
    (unless (eq (h-gravity (image-origin image))
                (h-gravity origin))
      (mirror image :horizontally))
    (unless (eq (v-gravity (image-origin image))
                (v-gravity origin))
      (mirror image :vertically)))
  (setf (image-origin image) origin))

(defun mirror (image direction)
  (let ((row-length (truncate (w image) 2))
        (row-stride (row-stride image))
        (layout-stride (pixel-stride (layout image)))
        (channel-stride (pixel-stride (channel-type image)))
        (layer-stride (layer-stride image))
        (pixel-stride (pixel-stride image))
        (data (data image))
        (h (h image))
        (d (d image)))
    (declare (optimize speed))
    (declare (type dimension h d))
    (declare (type stride row-length row-stride layout-stride channel-stride layer-stride pixel-stride))
    ;; Optimize common case of Y-flipping on octet vectors
    (if (and (typep data '(simple-array (unsigned-byte 8) (*))) (case direction ((:vertically :vertical :y) T)))
        (loop for z of-type (unsigned-byte 32) from 0 below (max 1 d)
              do (loop for y1 of-type (unsigned-byte 32) from 0 below (floor h 2)
                          for y2 of-type (unsigned-byte 32) downfrom (1- h)
                          do (loop for x1 of-type (unsigned-byte 32) from (+ (* y1 row-stride) (* z layer-stride))
                                   for x2 of-type (unsigned-byte 32) from (+ (* y2 row-stride) (* z layer-stride))
                                   repeat row-stride
                                   do (rotatef (aref data x1) (aref data x2)))))
        (with-image-pixels (pix image)
          (ecase direction
            ((:horizontally :horizontal :x)
             (loop for z of-type (unsigned-byte 32) from 0 below (max 1 d)
                   do (loop for y of-type (unsigned-byte 32) from 0 below h
                            do (loop for x1 of-type (unsigned-byte 32) from (+ (* y row-stride) (* z layer-stride)) by pixel-stride
                                     for x2 of-type (unsigned-byte 32) downfrom (- (+ (* (1+ y) row-stride) (* z layer-stride)) pixel-stride) by pixel-stride
                                     repeat row-length
                                     do (loop for i from 0 by channel-stride
                                              repeat layout-stride
                                              do (rotatef (pix (+ x1 i)) (pix (+ x2 i))))))))
            ((:vertically :vertical :y)
             (loop for z of-type (unsigned-byte 32) from 0 below (max 1 d)
                   do (loop for y1 of-type (unsigned-byte 32) from 0 below (floor h 2)
                            for y2 of-type (unsigned-byte 32) downfrom (1- h)
                            do (loop for x1 of-type (unsigned-byte 32) from (+ (* y1 row-stride) (* z layer-stride)) by channel-stride
                                     for x2 of-type (unsigned-byte 32) from (+ (* y2 row-stride) (* z layer-stride)) by channel-stride
                                     repeat row-stride
                                     do (rotatef (pix x1) (pix x2)))))))))
    image))

(defun rotate (image amount)
  (let* ((old (data image))
         (type (channel-type image))
         (layout-stride (pixel-stride (layout image)))
         (channel-stride (pixel-stride (channel-type image)))
         (pixel-stride (pixel-stride image))
         (d (d image))
         (h (h image))
         (w (w image)))
    (with-pixel-data (src old type)
      (case amount
        ((180 :flip)
         (let ((max (* w h d)))
           (loop repeat (truncate max 2)
                 for i1 from 0 by pixel-stride
                 for i2 downfrom (* (1- max) pixel-stride) by pixel-stride
                 do (dotimes (c layout-stride)
                      (rotatef (src (+ i1 (* c channel-stride)))
                               (src (+ i2 (* c channel-stride))))))))
        (T
         ;; I'm too dumb to do this without copying.
         (let ((new (make-array (length old) :element-type '(unsigned-byte 8)))
               (layer-stride (layer-stride image))
               (row-stride (row-stride image)))
           (with-pixel-data (dst new type)
             (ecase amount
               ((+90 :cw)
                (dotimes (z (d image))
                  (dotimes (y (h image))
                    (dotimes (x (w image))
                      (loop for c0 from (+ (* z layer-stride) (* y row-stride) (* x pixel-stride)) by channel-stride
                            for c1 from (+ (* z layer-stride) (* x row-stride) (* (- (w image) y 1) pixel-stride)) by channel-stride
                            repeat layout-stride
                            do (setf (dst c1) (src c0)))))))
               ((-90 270 :ccw)
                (dotimes (z (d image))
                  (dotimes (y (h image))
                    (dotimes (x (w image))
                      (loop for c0 from (+ (* z layer-stride) (* y row-stride) (* x pixel-stride)) by channel-stride
                            for c1 from (+ (* z layer-stride) (* (- (h image) x 1) row-stride) (* y pixel-stride)) by channel-stride
                            repeat layout-stride
                            do (setf (dst c1) (src c0)))))))))
           (rotatef (image-w image) (image-h image))
           (setf (image-data image) new)))))
    image))

(defun resize (image &key (w (w image)) (h (h image)) (d (d image)) (gravity :zero))
  (unless (and (= w (w image)) (= h (h image)) (= d (d image)))
    (let* ((new (make-array (* w h d (pixel-stride image)) :element-type '(unsigned-byte 8) :initial-element 0))
           (tmp (make-image* new (channel-type image) (layout image) w h d (origin image)))
           (view (destructuring-bind (&optional (gx :center) (gy gx) (gz gx))
                     (etypecase gravity
                       (list gravity)
                       (keyword (list gravity)))
                   (flet ((gravity (gravity dst src)
                            (ecase gravity
                              (:zero 0)
                              (:center (truncate (- dst src) 2))
                              (:opposite (- dst src)))))
                     (make-view tmp :x (gravity gx w (w image))
                                    :y (gravity gy h (h image))
                                    :z (gravity gz d (d image)))))))
      (declare (dynamic-extent tmp view))
      (transfer image view)
      (setf (image-data image) new)
      (setf (image-w image) w)
      (setf (image-h image) h)
      (setf (image-d image) d)))
  image)

(defun scale (image &key (w (w image)) (h (h image)) (d (d image)) (interpolation :linear))
  (scale-image interpolation image w h d)
  (setf (image-w image) w)
  (setf (image-h image) h)
  (setf (image-d image) d)
  image)

(defgeneric scale-image (interpolation image w h d))

(defmethod scale-image ((_ (eql :nearest)) (image image) dstw dsth dstd)
  ;; FIXME: This is horrendously dumb and slow for reasons that should be obvious.
  (let* ((type (channel-type image))
         (layout-stride (pixel-stride (layout image)))
         (channel-stride (pixel-stride (channel-type image)))
         (pixel-stride (pixel-stride image))
         (new (make-array (* dstw dsth dstd pixel-stride) :element-type '(unsigned-byte 8)))
         (old (data image))
         (srcw (w image))
         (srch (h image))
         (srcd (d image)))
    (flet ((idx (c x y z w h)
             (* channel-stride (+ c (* layout-stride (+ x (* w (+ y (* h z)))))))))
      (with-pixel-data (src old type)
        (with-pixel-data (dst new type)
          (dotimes (dstz dstd)
            (let ((srcz (round (* (/ dstz (1- dstd)) (1- srcd)))))
              (dotimes (dsty dsth)
                (let ((srcy (round (* (/ dsty (1- dsth)) (1- srch)))))
                  (dotimes (dstx dstw)
                    (let ((srcx (round (* (/ dstx (1- dstw)) (1- srcw)))))
                      (dotimes (c layout-stride)
                        (setf (dst (idx c dstx dsty dstz dstw dsth))
                              (src (idx c srcx srcy srcz srcw srch)))))))))))))
    (setf (image-data image) new)))

(defmethod scale-image ((_ (eql :linear)) (image image) dstw dsth dstd)
  ;; FIXME: This is horrendously dumb and slow for reasons that should be obvious.
  (let* ((type (channel-type image))
         (layout-stride (pixel-stride (layout image)))
         (channel-stride (pixel-stride (channel-type image)))
         (pixel-stride (pixel-stride image))
         (new (make-array (* dstw dsth dstd pixel-stride) :element-type '(unsigned-byte 8)))
         (old (data image))
         (srcw (w image))
         (srch (h image))
         (srcd (d image)))
    (with-pixel-data (src old type)
      (with-pixel-data (dst new type)
        (labels ((idx (c x y z w h d)
                   (* channel-stride (+ c (* layout-stride (+ (min (1- w) x) (* w (+ (min (1- h) y) (* h (min (1- d) z)))))))))
                 (lerp (a b x)
                   (+ a (* (- b a) x)))
                 (sample (c x y z xint yint zint)
                   (lerp (lerp (lerp (src (idx c (+ 0 x) (+ 0 y) (+ 0 z) srcw srch srcd))
                                     (src (idx c (+ 1 x) (+ 0 y) (+ 0 z) srcw srch srcd))
                                     xint)
                               (lerp (src (idx c (+ 0 x) (+ 1 y) (+ 0 z) srcw srch srcd))
                                     (src (idx c (+ 1 x) (+ 1 y) (+ 0 z) srcw srch srcd))
                                     xint)
                               yint)
                         (lerp (lerp (src (idx c (+ 0 x) (+ 0 y) (+ 1 z) srcw srch srcd))
                                     (src (idx c (+ 1 x) (+ 0 y) (+ 1 z) srcw srch srcd))
                                     xint)
                               (lerp (src (idx c (+ 0 x) (+ 1 y) (+ 1 z) srcw srch srcd))
                                     (src (idx c (+ 1 x) (+ 1 y) (+ 1 z) srcw srch srcd))
                                     xint)
                               yint)
                         zint)))
          (dotimes (dstz dstd)
            (multiple-value-bind (srcz zint) (floor (* (/ dstz (1- dstd)) srcd))
              (dotimes (dsty dsth)
                (multiple-value-bind (srcy yint) (floor (* (/ dsty (1- dsth)) srch))
                  (dotimes (dstx dstw)
                    (multiple-value-bind (srcx xint) (floor (* (/ dstx (1- dstw)) srcw))
                      (dotimes (c layout-stride)
                        (setf (dst (idx c dstx dsty dstz dstw dsth dstd))
                              (sample c srcx srcy srcz xint yint zint))))))))))))
    (setf (image-data image) new)))
