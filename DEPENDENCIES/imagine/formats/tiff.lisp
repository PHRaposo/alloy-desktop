(in-package #:org.shirakumo.fraf.imagine)

(defmethod load-image ((stream stream) (type (eql :tiff)) &key (decode T))
  (declare (ignore decode))
  (let* ((tiff (retrospectiff:read-tiff-stream stream))
         (w (retrospectiff:tiff-image-width tiff))
         (h (retrospectiff:tiff-image-length tiff))
         (cmap (retrospectiff:tiff-image-color-map tiff))
         (data (retrospectiff:tiff-image-data tiff))
         (bits (let ((b (retrospectiff:tiff-image-bits-per-sample tiff)))
                 (if (vectorp b) (aref b 0) b))))
    (if cmap
        (let ((rgb (make-array (* w h 3) :element-type '(unsigned-byte 8))))
          (dotimes (i (* w h))
            (destructuring-bind (r g b) (aref cmap (aref data i))
              (setf (aref rgb (* 3 i)) (ash r -8)
                    (aref rgb (+ (* 3 i) 1)) (ash g -8)
                    (aref rgb (+ (* 3 i) 2)) (ash b -8))))
          (make-image* rgb :unsigned-byte :rgb w h))
        (make-image* data (infer-channel-type bits)
                     (ecase (retrospectiff:tiff-image-samples-per-pixel tiff)
                       (1 :r) (3 :rgb) (4 :rgba)) w h))))

(defmethod load-image :around (source (type (eql :tif)) &rest args &key &allow-other-keys)
  (apply #'load-image source :tiff args))

(defmethod save-image :around (source target (type (eql :tif)) &rest args &key &allow-other-keys)
  (apply #'save-image source target :tiff args))

(defmethod save-image ((source image) (stream stream) (type (eql :tiff)) &key)
  (declare (ignore type))
  (check-image-compatible source '(:rgba) :channel-types '(:unsigned-byte))
  (let* ((w (w source)) (h (h source)) (data (data source))
         (bottom-up (eq (origin source) :bottom-left))
         (oi (opticl-core:make-8-bit-rgba-image h w)))
    (dotimes (j h)
      (let ((src-base (* 4 w (if bottom-up (- h 1 j) j)))
            (dst-base (* 4 w j)))
        (dotimes (b (* 4 w))
          (setf (row-major-aref oi (+ dst-base b)) (aref data (+ src-base b))))))
    (retrospectiff2:write-tiff-stream stream oi)
    source))
