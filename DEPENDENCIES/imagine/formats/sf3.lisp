(in-package #:org.shirakumo.fraf.imagine)

(defmethod load-image ((stream stream) (type (eql :sf3)) &key (decode T))
  (cond (decode
         (let ((image (org.shirakumo.sf3:read-sf3 stream)))
           (check-type image org.shirakumo.sf3:image)
           (make-image* (org.shirakumo.sf3:pixels image)
                        (ecase (org.shirakumo.sf3:pixel-format image)
                          (:uint8 :unsigned-byte)
                          (:uint16 :unsigned-short)
                          (:uint32 :unsigned-int)
                          (:sint8 :signed-byte)
                          (:sint16 :signed-short)
                          (:sint32 :signed-int)
                          (:float16 :half-float)
                          (:float32 :float)
                          (:float64 :double))
                        (ecase (org.shirakumo.sf3:channels image)
                          (#x01 :r)
                          (#x02 :ra)
                          (#x03 :rgb)
                          (#x04 :rgba)
                          (#x13 :bgr)
                          (#x34 :bgra))
                        (org.shirakumo.sf3:width image)
                        (org.shirakumo.sf3:height image)
                        (org.shirakumo.sf3:depth image))))
        (T
         (assert (eql 'org.shirakumo.sf3:image (org.shirakumo.sf3:tell-sf3 stream)))
         (let ((w (nibbles:read-ub32/le stream))
               (h (nibbles:read-ub32/le stream))
               (d (nibbles:read-ub32/le stream))
               (c (read-byte stream))
               (p (read-byte stream)))
           (make-image* NIL
                        (ecase p
                          (#x11 :unsigned-byte)
                          (#x12 :unsigned-short)
                          (#x14 :unsigned-int)
                          (#x01 :signed-byte)
                          (#x02 :signed-short)
                          (#x04 :signed-int)
                          (#x22 :half-float)
                          (#x24 :float)
                          (#x28 :double))
                        (ecase c
                          (#x01 :r)
                          (#x02 :ra)
                          (#x03 :rgb)
                          (#x04 :rgba)
                          (#x13 :bgr)
                          (#x34 :bgra))
                        w h d)))))

(defmethod save-image ((source image) (stream stream) (type (eql :sf3)) &key)
  (check-image-compatible source '(:r :ra :rgb :rgba))
  (let ((image (org.shirakumo.sf3:make-image
                (data source) (w source) (h source) :depth (d source) :pixel-type
                (ecase (layout source)
                  (:r :v)
                  (:ra :va)
                  (:ar :av)
                  (T (layout source))))))
    (org.shirakumo.sf3:write-sf3 image stream)))
