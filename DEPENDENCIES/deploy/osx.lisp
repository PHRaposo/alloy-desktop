(in-package #:org.shirakumo.deploy)

(defvar *info-plist-template* (merge-pathnames "Info.plist.in" *here*))
(defvar *macos-app-icon* (merge-pathnames "AppIcon.icns" *here*))
(defvar *macos-entitlements* (merge-pathnames "entitlements.plist" *here*))

(defclass osx-app-deploy-op (deploy-op)
  ((bundle-path :initarg :bundle-path :initform NIL :accessor bundle-path)))

(defclass macos-app-deploy-op (osx-app-deploy-op)
  ())

(defmethod bundle-name ((op osx-app-deploy-op))
  #+asdf
  (or (asdf:system-long-name (system op))
      (asdf:component-name (system op)))
  #-asdf
  (pathname-name (output-file op)))

(defmethod output-data-directory ((op osx-app-deploy-op))
  (merge-pathnames "Contents/Resources/" (bundle-path op)))

(defmethod deploy :before ((o macos-app-deploy-op) &key &allow-other-keys)
  (setf *library-location* #p"../Frameworks/")
  (setf *base-location* #p"../../../")
  (let* ((base (pathname-utils:to-directory (output-file o)))
         (bundle-dir (merge-pathnames (format NIL "~a.app/" (bundle-name o)) base))
         (macos-dir (merge-pathnames "Contents/MacOS/" bundle-dir))
         (bin-file #+sbcl (merge-pathnames "sbcl.core" macos-dir)
                   #-sbcl (merge-pathnames (pathname-name (output-file o)) macos-dir)))
    (setf (bundle-path o) bundle-dir)
    (setf (output-file o) bin-file)
    (values (list bin-file) T))
  (status 0 "Preparing macOS app bundle.")
  (let* ((bundle-name (bundle-name o))
         (contents-dir (merge-pathnames "Contents/" (bundle-path o)))
         (macos-dir (merge-pathnames "MacOS/" contents-dir))
         (resources-dir (merge-pathnames "Resources/" contents-dir)))
    (dolist (dir (list macos-dir resources-dir))
      (ensure-directories-exist (merge-pathnames ".dummy" dir)))
    (let ((info-plist-file (merge-pathnames "Info.plist" contents-dir)))
      (status 1 "Generating ~a" info-plist-file)
      (create-template (system o) *info-plist-template* info-plist-file))
    (let ((icon-target (make-pathname :name bundle-name :type "icns" :defaults resources-dir)))
      (when (probe-file *macos-app-icon*)
        (status 1 "Copying icon ~a" *macos-app-icon*)
        (copy-file *macos-app-icon* icon-target)))
    #+sbcl
    (let ((runtime-target (make-pathname :name bundle-name :type NIL :defaults macos-dir)))
      (status 1 "Copying SBCL runtime to ~a" runtime-target)
      (copy-file sb-ext:*runtime-pathname* runtime-target)
      (run "chmod" "755" runtime-target))
    #+sbcl (pushnew :deploy-image *features*)))

(defun appname (app)
  (let ((dir (if (pathname-utils:directory-p app)
                 (pathname-utils:directory-name app)
                 (file-namestring app))))
    (if (and (< 4 (length dir)) (string= dir ".app" :start1 (- (length dir) 4)))
        (values (subseq dir 0 (- (length dir) 4)) T)
        (values dir NIL))))

(defun sign-app (app cert &key (entitlements *macos-entitlements*) identifier options)
  (let ((app (pathname-utils:force-directory app)))
    (flet ((sign (file)
             (run "codesign" "-s" cert "--force"
                  (list "--options" (format NIL "~{~a~^,~a~}" (list* "runtime" options)))
                  (when entitlements (list "--entitlements" entitlements))
                  (when identifier (list "--identifier" identifier))
                  file)))
      (when (nth-value 1 (appname app))
        ;; Note: signing separately and in this exact order is actually very important
        ;;       otherwise the verification will fail for ???? reasons.
        (let ((libs (directory (merge-pathnames "Contents/Frameworks/**/*.*" app)))
              (exes (directory (merge-pathnames "Contents/MacOS/*.*" app))))
          (dolist (lib libs)
            (patch-dependencies-using libs lib))
          (dolist (exe exes)
            (when (string/= "sbcl.core" (file-namestring exe))
              (patch-dependencies-using libs exe :key (lambda (f) (format NIL "@loader_path/../Frameworks/~a"
                                                                          (file-namestring f))))
              (run "chmod" "+x" exe)))
          (mapc #'sign libs)
          (sign (merge-pathnames "Contents/MacOS/sbcl.core" app))
          (dolist (exe exes)
            (when (string/= "sbcl.core" (file-namestring exe))
              (sign exe)))))
      (sign (pathname-utils:force-file app)))
    app))

(defun make-dmg (app &key (name (appname app))
                          (dmg (merge-pathnames (make-pathname :type "dmg" :name name)
                                                (pathname-utils:parent app)))
                          (links '(:applications)) extras
                          background (volume-icon *macos-app-icon*)
                          (window-bounds '(:X 10 :Y 60 :W 800 :H 400))
                          (icon-position '(:X 200 :Y 180))
                          (icon-size 128) (text-size 16)
                          sign notarize verbose)
  (when verbose (status 0 "Creating dmg for app at ~a" app))
  (let ((dev NIL)
        (target-app (format NIL "~a.app" name))
        (tmp (make-pathname :name (format NIL "deploy.tmp.~36,4,'0r" (random #xFFFF)) :type "dmg" :directory '(:absolute "tmp")))
        (script (pathname-utils:parse-native-namestring (run "mktemp" "-t" "deploy.script.XXXX") :as :file))
        (mount (pathname-utils:parse-native-namestring (run "mktemp" "-d" "-t" "deploy.mount.XXXX") :as :directory))
        (script-extra ())
        (size (parse-integer (run "du" "-sm" app) :junk-allowed T)))
    (flet ((add-script (format &rest args)
             (push (format NIL "try~%~?~%end try" format args) script-extra)))
      (when verbose (status 1 "Creating temporary image of ~dMB at ~a" size tmp))
      (run "hdiutil" "create" "-size" (format NIL "~dm" (+ size 32)) "-type" "UDIF" "-nospotlight" "-fs" "APFS" "-volname" name "-ov" tmp)
      (ensure-directories-exist mount)
      (when verbose (status 1 "Mounting to ~a" mount))
      (let* ((mountinfo (run "hdiutil" "attach" "-mountpoint" mount "-readwrite" "-noverify" "-noautoopen" "-nobrowse" tmp))
             (pos (search "/dev/" mountinfo :from-end T)))
        (when pos (setf dev (subseq mountinfo (+ pos 5) (position #\Space mountinfo :start pos)))))
      (unwind-protect
           (progn
             (when verbose (status 1 "Copying app to ~a" target-app))
             (run "cp" "-r" app (pathname-utils:subdirectory mount target-app))
             (add-script "set position of item ~s to {~d, ~d}"
                         target-app (getf icon-position :x) (getf icon-position :y))
             (add-script "set the extension hidden of item ~s to true"
                         target-app)
             (when background
               (when verbose (status 1 "Copying background image"))
               (ensure-directories-exist (pathname-utils:subdirectory mount ".background"))
               (copy-file background (pathname-utils:subdirectory mount ".background"))
               (add-script "set background picture of opts to file \".background:~a\""
                           (file-namestring background)))
             (when volume-icon
               (when verbose (status 1 "Copying volume icon"))
               (copy-file volume-icon (merge-pathnames ".VolumeIcon.icns" mount))
               (run "SetFile" "-c" "icnC" (merge-pathnames ".VolumeIcon.icns" mount)))
             ;; TODO: better default layouting mechanism
             (dolist (link links)
               (destructuring-bind (src name &key (x (- (getf window-bounds :w) 200)) (y 180))
                   (etypecase link
                     (cons link)
                     ((eql :applications) (list "/Applications" "Applications"))
                     ((eql :quicklook) (list "/Library/QuickLook" "QuickLook"))
                     ((or pathname string) (list link (file-namestring link))))
                 (when verbose (status 1 "Adding link to ~s as ~s" src name))
                 (run "ln" "-s" src (merge-pathnames name mount))
                 (add-script "set position of item ~s to {~d, ~d}" name x y)))
             (dolist (extra extras)
               (destructuring-bind (src name &key (x 200) (y (- (getf window-bounds :h) 180)))
                   (if (listp extra) extra (list extra (file-namestring extra)))
                 (when verbose (status 1 "Copying file from ~s as ~s" src name))
                 (copy-directory-tree src (merge-pathnames name mount))
                 (add-script "set position of item ~s to {~d, ~d}" name x y)))
             (create-template NIL (merge-pathnames "applescript.in" *here*) script
                              (lambda (k o)
                                (declare (ignore o))
                                (case k
                                  (:WIN-X (getf window-bounds :X))
                                  (:WIN-Y (getf window-bounds :Y))
                                  (:WIN-W (getf window-bounds :W))
                                  (:WIN-H (getf window-bounds :H))
                                  (:ICON-SIZE icon-size)
                                  (:TEXT-SIZE text-size)
                                  (:SCRIPT (format NIL "~{~a~%~}" script-extra)))))
             (when verbose (status 1 "Running applescript to create Finder settings"))
             (run "/usr/bin/osascript" script (pathname-utils:directory-name mount) mount)
             (sleep 4)
             (when verbose (status 1 "Cleaning up"))
             (ignore-errors (delete-file script))
             (run "chmod" "-Rf" "go-w" mount)
             (run "SetFile" "-a" "C" mount)
             (ignore-errors (delete-file (merge-pathnames ".fseventsd" mount))))
        (when verbose (status 1 "Detaching mount"))
        (run "hdiutil" "detach" dev)
        (ignore-errors (run "rm" "-r" mount)))
      (ignore-errors (delete-file dmg))
      (when verbose (status 1 "Converting and compressing to ~a" dmg))
      (run "hdiutil" "convert" tmp "-format" "UDZO" "-o" dmg)
      (ignore-errors (delete-file tmp))
      (when sign
        (sign-app dmg sign)
        (run "codesign" "--verify" "--deep" "--verbose=2" dmg))
      (when notarize
        (when verbose (status 1 "Notarizing the dmg with profile ~a" notarize))
        (let ((*run-output* (when verbose *status-output*)))
          (run "xcrun" "notarytool" "submit" dmg "--keychain-profile" notarize "--wait"))
        (when verbose (status 1 "Stapling notary ticket"))
        (run "xcrun" "stapler" "staple" dmg))
      dmg)))

;; hook ASDF
#+asdf3
(flet ((export! (symbol package)
         (import symbol package)
         (export symbol package)))
  (export! 'osx-app-deploy-op :asdf/bundle)
  (export! 'osx-app-deploy-op :asdf)
  (export! 'macos-app-deploy-op :asdf/bundle)
  (export! 'macos-app-deploy-op :asdf))
